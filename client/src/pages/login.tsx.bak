
import { useState, useEffect } from "react";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import { Alert, AlertDescription } from "@/components/ui/alert";
import axiosClient from "@/lib/axiosClient";
import Logo from "@/components/ui/logo";

export default function Login() {
  const [email, setEmail] = useState("");
  const [password, setPassword] = useState("");
  const [error, setError] = useState("");
  const [isLoading, setIsLoading] = useState(false);

  const handleLogin = async (e: React.FormEvent) => {
    e.preventDefault();
    setIsLoading(true);
    setError("");

    try {
      // Input validation
      if (!email.trim() || !password.trim()) {
        throw new Error('Email and password are required');
      }

      console.log('Attempting login with:', { email: email.trim() });
      
      // Use direct fetch API with full URL to troubleshoot connection issues
      const apiUrl = window.location.hostname === 'localhost' ? 
        'http://localhost:3000' : 
        `http://${window.location.hostname}:3000`;
      
      console.log('Using API URL:', apiUrl);
      
      try {
        // First try using axios (preferred method)
        const response = await axiosClient.post('/api/auth/login', { 
          email: email.trim(), 
          password: password.trim() 
        });
        
        console.log('Login response:', response);
        
        if (!response || !response.data) {
          throw new Error('Invalid response from server');
        }
        
        const { token, user } = response.data;
        
        if (!token) {
          throw new Error('Authentication failed: No token received');
        }
        
        if (!user) {
          throw new Error('Authentication failed: No user data received');
        }
        
        if (!user.isActive) {
          throw new Error('Account is deactivated. Please contact support.');
        }
        
        // Store token in localStorage
        localStorage.setItem('auth_token', token);
        localStorage.setItem('user', JSON.stringify(user));
        
        // Clear any existing errors
        setError('');
        
        console.log('Login successful, redirecting to dashboard');
        
        // Redirect to dashboard
        window.location.href = '/dashboard';
      } catch (axiosError) {
        console.error('Axios login failed, trying direct fetch:', axiosError);
        
        // Fallback to direct fetch if axios fails
        const response = await fetch(`${apiUrl}/api/auth/login`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ 
            email: email.trim(), 
            password: password.trim() 
          }),
          credentials: 'include',
        });
        
        console.log('Fetch login status:', response.status);
        
        if (!response.ok) {
          if (response.status === 401) {
            throw new Error('Invalid email or password');
          } else if (response.status === 403) {
            throw new Error('Account is deactivated. Please contact support.');
          } else {
            const errorData = await response.json().catch(() => ({}));
            throw new Error(errorData.message || `Server error: ${response.status}`);
          }
        }
        
        const data = await response.json();
        console.log('Fetch login response:', data);
        
        if (!data.token || !data.user) {
          throw new Error('Invalid response from server');
        }
        
        // Store token in localStorage
        localStorage.setItem('auth_token', data.token);
        localStorage.setItem('user', JSON.stringify(data.user));
        
        // Redirect to dashboard
        window.location.href = '/dashboard';
      }
    } catch (err: any) {
      console.error('Login error:', err);
      
      // Handle specific error scenarios
      if (err.message?.includes('Network Error') || err.message?.includes('Failed to fetch')) {
        setError('Unable to connect to the server. Please ensure the server is running.');
      } else if (err.response?.status === 401 || err.message?.includes('Invalid email or password')) {
        setError('Invalid email or password');
      } else if (err.response?.status === 403 || err.message?.includes('deactivated')) {
        setError('Account is deactivated. Please contact support.');
      } else if (err.response?.status === 404 || err.message?.includes('Not Found')) {
        setError('API endpoint not found. The server may be misconfigured.');
      } else {
        setError(err.message || 'An unexpected error occurred');
      }
    } finally {
      setIsLoading(false);
    }
  };

  return (
    <div className="min-h-screen bg-quantum-dark text-quantum-text flex items-center justify-center p-6" style={{ backgroundColor: '#0B101B', color: '#E6EDF8' }}>
      <div className="w-full max-w-md">
        <Card className="bg-quantum-gray border border-quantum-accent/20 shadow-xl shadow-quantum-accent/10" style={{ backgroundColor: '#151C2C', borderColor: 'rgba(0, 217, 255, 0.2)', boxShadow: '0 5px 20px rgba(0, 217, 255, 0.1)' }}>
          <CardHeader className="text-center">
            <div className="flex justify-center mb-4">
              <Logo size="lg" animated={true} />
            </div>
            <CardTitle className="text-2xl font-bold">
              <span className="bg-gradient-to-r from-quantum-accent to-quantum-success bg-clip-text text-transparent" style={{ 
                backgroundImage: 'linear-gradient(to right, #00D9FF, #00FF91)', 
                WebkitBackgroundClip: 'text', 
                WebkitTextFillColor: 'transparent',
                backgroundClip: 'text'
              }}>
                QuantumTrade AI
              </span>
            </CardTitle>
            <p className="text-quantum-text-secondary mt-1" style={{ color: '#7A8499' }}>Access your trading platform</p>
          </CardHeader>
          <CardContent>
            <form onSubmit={handleLogin} className="space-y-4">
              {error && (
                <Alert className="border-quantum-danger/20 bg-quantum-danger/10">
                  <AlertDescription className="text-quantum-danger">
                    {error}
                  </AlertDescription>
                </Alert>
              )}
              
              <div className="space-y-2">
                <label htmlFor="email" className="text-sm font-medium text-quantum-text">
                  Email
                </label>
                <Input
                  id="email"
                  type="email"
                  value={email}
                  onChange={(e) => setEmail(e.target.value)}
                  className="bg-quantum-dark border-quantum-accent/20 text-quantum-text"
                  placeholder="Enter your email"
                  style={{ 
                    backgroundColor: '#0B101B', 
                    borderColor: 'rgba(0, 217, 255, 0.2)', 
                    color: '#E6EDF8',
                    padding: '0.75rem',
                    fontSize: '0.875rem',
                    borderRadius: '0.375rem'
                  }}
                  required
                />
              </div>
              
              <div className="space-y-2">
                <label htmlFor="password" className="text-sm font-medium text-quantum-text">
                  Password
                </label>
                <Input
                  id="password"
                  type="password"
                  value={password}
                  onChange={(e) => setPassword(e.target.value)}
                  className="bg-quantum-dark border-quantum-accent/20 text-quantum-text"
                  placeholder="Enter your password"
                  style={{ 
                    backgroundColor: '#0B101B', 
                    borderColor: 'rgba(0, 217, 255, 0.2)', 
                    color: '#E6EDF8',
                    padding: '0.75rem',
                    fontSize: '0.875rem',
                    borderRadius: '0.375rem'
                  }}
                  required
                />
              </div>
              
              <Button
                type="submit"
                disabled={isLoading}
                className="w-full bg-gradient-to-r from-quantum-accent to-quantum-success hover:from-quantum-accent/80 hover:to-quantum-success/80 text-quantum-dark font-semibold"
                style={{ 
                  backgroundImage: 'linear-gradient(to right, #00D9FF, #00FF91)', 
                  color: '#0B101B', 
                  fontWeight: '600',
                  width: '100%',
                  opacity: isLoading ? 0.7 : 1
                }}
              >
                {isLoading ? 'Signing In...' : 'Sign In'}
              </Button>
            </form>
            
            <div className="mt-6 text-center">
              <p className="text-sm text-quantum-text-secondary">
                Don't have an account?{' '}
                <a href="/register" className="text-quantum-accent hover:text-quantum-success font-medium">
                  Create one here
                </a>
              </p>
            </div>
            
            <div className="mt-4 p-4 bg-quantum-accent/10 rounded-lg">
              <h3 className="text-sm font-medium text-quantum-text mb-2">Demo Credentials:</h3>
              <div className="text-xs text-quantum-text-secondary space-y-1">
                <div><strong>Admin:</strong> admin@quantumtrade.ai / admin123</div>
                <div><strong>User:</strong> user@quantumtrade.ai / user123</div>
              </div>
            </div>
          </CardContent>
        </Card>
      </div>
    </div>
  );
}
