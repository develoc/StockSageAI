import React from "react";

interface LogoProps {
  size?: "sm" | "md" | "lg" | "xl";
  variant?: "default" | "light" | "dark";
  animated?: boolean;
  className?: string;
}

export const Logo: React.FC<LogoProps> = ({
  size = "md",
  variant = "default",
  animated = true,
  className = "",
}) => {
  // Size mappings
  const sizeClasses = {
    sm: "w-8 h-8",
    md: "w-12 h-12",
    lg: "w-16 h-16",
    xl: "w-24 h-24",
  };
  
  // Variant mappings
  const variantClasses = {
    default: "bg-gradient-to-br from-quantum-accent to-quantum-success text-quantum-dark",
    light: "bg-gradient-to-br from-quantum-accent to-quantum-accent text-quantum-dark",
    dark: "bg-gradient-to-br from-quantum-dark to-quantum-gray text-quantum-accent",
  };
  
  // Animation class
  const animationClass = animated ? "animate-pulse-glow" : "";
  
  // Add inline styles as a fallback for Tailwind classes
  const inlineStyle = {
    background: variant === 'default' 
      ? 'linear-gradient(to bottom right, #00D9FF, #00FF91)' 
      : variant === 'light'
      ? 'linear-gradient(to bottom right, #00D9FF, #00D9FF)'
      : 'linear-gradient(to bottom right, #0B101B, #151C2C)',
    color: variant === 'dark' ? '#00D9FF' : '#0B101B',
    boxShadow: '0 0 10px rgba(0, 217, 255, 0.3)',
    display: 'flex',
    alignItems: 'center',
    justifyContent: 'center',
    borderRadius: '0.75rem',
  };
  
  // Size inline styles
  const sizeStyle = {
    width: size === 'sm' ? '2rem' : size === 'lg' ? '4rem' : size === 'xl' ? '6rem' : '3rem',
    height: size === 'sm' ? '2rem' : size === 'lg' ? '4rem' : size === 'xl' ? '6rem' : '3rem',
  };
  
  return (
    <div 
      className={`${sizeClasses[size]} ${variantClasses[variant]} rounded-xl flex items-center justify-center shadow-lg shadow-quantum-accent/20 ${animationClass} ${className}`}
      style={{ ...inlineStyle, ...sizeStyle }}
    >
      <svg 
        className={`${size === "sm" ? "w-4 h-4" : size === "lg" ? "w-8 h-8" : size === "xl" ? "w-12 h-12" : "w-6 h-6"}`} 
        style={{
          width: size === 'sm' ? '1rem' : size === 'lg' ? '2rem' : size === 'xl' ? '3rem' : '1.5rem',
          height: size === 'sm' ? '1rem' : size === 'lg' ? '2rem' : size === 'xl' ? '3rem' : '1.5rem',
        }}
        viewBox="0 0 24 24" 
        fill="none" 
        xmlns="http://www.w3.org/2000/svg"
      >
        <path d="M12 22C17.5228 22 22 17.5228 22 12C22 6.47715 17.5228 2 12 2C6.47715 2 2 6.47715 2 12C2 17.5228 6.47715 22 12 22Z" stroke="currentColor" strokeWidth="2" />
        <path d="M12 7V12L16 14" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" />
      </svg>
    </div>
  );
};

export default Logo;