# Database Configuration
DATABASE_URL=postgresql://dbadmin:dbadmin@localhost:5432/stockage_db

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Server Configuration
NODE_ENV=development
PORT=3000

# API Keys for External Services
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-api-key
COINGECKO_API_KEY=your-coingecko-api-key

# Replit Configuration (only needed if deploying to Replit)
REPLIT_DOMAINS=your-replit-domain.repl.co
ISSUER_URL=https://replit.com/oidc
REPL_ID=your-repl-id
SESSION_SECRET=your-session-secret-key

# Optional: For production encryption (if needed)
ENCRYPTION_KEY=your-256-bit-encryption-key
